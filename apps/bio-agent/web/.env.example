# API key của công ty (console.anthropic.com). Chỉ đặt trong Vercel → Settings → Environment Variables.
ANTHROPIC_API_KEY=
# Tùy chọn: model và mức effort (mặc định claude-opus-5-5, medium)
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# Mã truy cập: nhãn:mã:số-bio-mỗi-ngày, cách nhau bằng dấu phẩy. Mã nên dài, ngẫu nhiên.
ACCESS_CODES=tomosia:thay-bang-ma-ngau-nhien:50
# Số bio mỗi ngày khi mã không ghi số (mặc định 20)
DAILY_BIO_LIMIT=
# Tùy chọn: Upstash Redis để giới hạn số bio mỗi mã mỗi ngày. Không có thì không giới hạn lượt.
KV_REST_API_URL=
KV_REST_API_TOKEN=
